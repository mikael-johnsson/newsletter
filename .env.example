# Neon pooled connection string, used by the app at runtime. Use a dev branch locally, never production.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Neon direct (non-pooled) connection string, used by Prisma migrations.
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
# Hash of the author's password. Generate with: ADMIN_PASSWORD='…' npm run admin:hash
ADMIN_PASSWORD_HASH="scrypt.salt.hash"
# Random string that signs the admin session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET="change-me"
