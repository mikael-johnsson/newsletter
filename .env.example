# Set every variable in every environment (local, Vercel Preview, Vercel Production), even if empty.

# --- Database (Neon) ---
# Pooled connection string (hostname contains "-pooler"), used by the app at runtime.
# Local and Preview: dev branch. Production: prod branch. Never point Preview at prod.
DATABASE_URL=""
# Direct (non-pooled) connection string, used only by the Prisma CLI (migrate, studio). Local only.
# Points at the dev branch. To migrate prod, point it at the prod branch temporarily and run db:deploy.
DIRECT_URL=""

# --- Admin login ---
# Hash of the author's password. Generate with: ADMIN_PASSWORD='…' npm run admin:hash
ADMIN_PASSWORD_HASH=""
# Signs the admin session cookie. Use a separate value per environment. Generate with: openssl rand -base64 32
SESSION_SECRET=""

# --- Mail (Resend) ---
# "all" sends to everyone (Production only), "allowlist" sends only to MAIL_ALLOWLIST, anything else only logs.
MAIL_SEND=""
# Comma-separated addresses that may receive mail when MAIL_SEND=allowlist. Local and Preview.
MAIL_ALLOWLIST=""
# Recipient of the "send test" button on /admin. All environments.
MAIL_TEST_TO=""
# Resend API key (called "newsletter" in the Resend dashboard). Needed whenever MAIL_SEND is on.
RESEND_API_KEY=""
MAIL_FROM="Nyhetsbrevet Push to main <hej@nyhetsbrev.pushtomain.se>"
# Verifies Resend webhook requests (bounces, complaints). Production: from the Resend webhook settings. Elsewhere: any value.
RESEND_WEBHOOK_SECRET=""

# --- Cron ---
# Vercel sends this to /api/cron/send in Production. Locally: any value, to call the route by hand.
CRON_SECRET=""
# Base URL of the site. Local: http://localhost:5173. Production: the prod URL.
SITE_URL=""
