# Prod database connection string. Not used locally, only for production deployments.
DATABASE_URL_PROD=""
# Neon pooled connection string, used by the app at runtime. Only used locally for development.
DATABASE_URL=""
# Neon direct (non-pooled) connection string, used by Prisma migrations. Leads to the dev branch.
DIRECT_URL=""
# Hash of the author's password. Generate with: ADMIN_PASSWORD='…' npm run admin:hash
ADMIN_PASSWORD_HASH=""
# Random string that signs the admin session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=""
# Resend API key for sending emails. Called newsletter in the Resend dashboard.
RESEND_API_KEY=""
#Where to send test emails. Only used locally for development.
MAIL_TEST_TO=""
# Allowlist of email addresses that can receive emails. 
MAIL_ALLOWLIST=""
# How to send emails. Only used locally for development.
MAIL_SEND=""
# From address for emails.
MAIL_FROM="Nyhetsbrevet Push to main <hej@nyhetsbrev.pushtomain.se>"
# Secret for verifying cron job requests.
CRON_SECRET=""
# Secret for verifying Resend webhook requests.
RESEND_WEBHOOK_SECRET=""