# Neon pooled connection string, used by the app at runtime. Use a dev branch locally, never production.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Neon direct (non-pooled) connection string, used by Prisma migrations.
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
# Hash of the author's password. Generate with: ADMIN_PASSWORD='…' npm run admin:hash
ADMIN_PASSWORD_HASH="scrypt.salt.hash"
# Random string that signs the admin session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET="change-me"
# Who gets real email: off (only logs), allowlist (only MAIL_ALLOWLIST) or all. Use all only in production.
MAIL_SEND="off"
# Comma-separated addresses that get real email when MAIL_SEND=allowlist. Without our own domain, Resend only delivers to the account owner.
MAIL_ALLOWLIST=""
# Where the admin "Skicka testmejl" button sends the current draft. Normally the author; it must be on MAIL_ALLOWLIST when MAIL_SEND=allowlist.
MAIL_TEST_TO=""
# Sender address. Until we verify our own domain, use Resend's test sender.
MAIL_FROM="Nyhetsbrevet Push to Main <onboarding@resend.dev>"
# Resend API key with sending access, from resend.com/api-keys.
RESEND_API_KEY=""
# Signing secret of the Resend webhook for bounces and complaints, from the webhook's page in Resend. Set the same value in Vercel.
RESEND_WEBHOOK_SECRET=""
# Secret Vercel Cron sends to /api/cron/send. Generate with: openssl rand -base64 32. Set the same value in Vercel.
CRON_SECRET=""
